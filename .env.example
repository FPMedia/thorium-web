# Copy to .env.local for `pnpm dev` / `pnpm build`.
# NEXT_PUBLIC_* values are inlined at `next build` — also set them as
# Workers Builds "Build variables and secrets" for production and staging.

# Firebase client (required)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Manifest route (optional; disabled in production unless FORCE_ENABLE is true)
# MANIFEST_ROUTE_FORCE_ENABLE must be present at both build time (next.config redirects)
# and runtime (src/app/ManifestRouteEnabled.ts).
# MANIFEST_ROUTE_FORCE_ENABLE=true
# MANIFEST_ALLOWED_DOMAINS=publication-server.readium.org

# CDN / subdirectory for static assets (build-time, optional)
# ASSET_PREFIX=https://cdn.example.com

# Dev only: extra origins allowed to load /_next assets (comma-separated)
# ALLOWED_DEV_ORIGINS=https://example.ngrok-free.app
