{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "thorium-web",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "thorium-web"
    }
  ],
  "vars": {
    // Payfast configuration
    // Set these values in your Cloudflare dashboard under Settings → Variables and Secrets
    "PAYFAST_MERCHANT_ID": "10036769",
    "PAYFAST_MERCHANT_KEY": "or0bp1xobul4s",
    "PAYFAST_MODE": "sandbox",
    // Firebase service account key - declared here so it's available to process.env
    // The actual value should be set as a SECRET in Cloudflare Dashboard
    // The secret value will override this placeholder at runtime
    "FIREBASE_SERVICE_ACCOUNT_KEY": ""
  },
  "r2_buckets": [
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // Uncomment and set bucket_name when you've created the R2 bucket in Cloudflare
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "thorium-web-cache"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}

